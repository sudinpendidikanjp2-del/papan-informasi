# Konfigurasi Papan Informasi. Salin ke /etc/papan-informasi.env lalu sesuaikan:
#   sudo install -m 0640 -o root -g papan deploy/papan-informasi.env.example /etc/papan-informasi.env
# Berkas ini berisi rahasia (password admin awal), jadi jangan dapat dibaca pengguna lain.

# Direktori data (database dan unggahan). Samakan dengan StateDirectory di berkas service.
DATA_DIR=/var/lib/papan-informasi

PORT=3000
# Di belakang reverse proxy pada mesin yang sama: dengarkan hanya loopback dan percayai header proxy.
HOST=127.0.0.1
# YOUTUBE=off   # matikan konten YouTube dan kembalikan CSP ke 'self' saja (bawaan: on)
TRUST_PROXY=1

# Akun admin pertama. Dipakai HANYA saat belum ada pengguna sama sekali (start pertama).
# Setelahnya ganti password lewat halaman Pegawai, lalu hapus baris ADMIN_PASSWORD dari berkas ini.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GANTI-DENGAN-PASSWORD-KUAT

# Subjek VAPID untuk notifikasi push (mailto: atau https: milik instansi). Opsional.
#VAPID_SUBJECT=mailto:admin@instansi.go.id

# Tanpa reverse proxy: HTTPS langsung dari aplikasi (lalu hapus HOST dan TRUST_PROXY di atas).
#TLS_CERT=/etc/papan-informasi/cert.pem
#TLS_KEY=/etc/papan-informasi/key.pem

# Batas opsional
#TICKET_RATE=30
#WS_MAX_PER_IP=100
